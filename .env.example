# Optional runtime configuration. Copy to .env only if you need to override a default.
INCIT_DATA_DIR=./data
INCIT_TEAM=InCIT
DATABASE_URL=sqlite:///./incit.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional URL used only by tests/solver_e2e.py.
INCIT_API_URL=http://localhost:8000

# Optional Gemini draft parser. Leave blank to use the manual booking form and
# deterministic parser only. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
